{
  "name": "screensync-mcp-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ScreenSync desktop ingestion hub and MCP server",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx index.ts",
    "test": "tsx test/catalog_consistency.test.ts && tsx test/e2e.ts && tsx test/flow.e2e.ts && tsx test/web_bridge.e2e.ts",
    "test:catalog": "tsx test/catalog_consistency.test.ts",
    "test:flow": "tsx test/flow.e2e.ts",
    "test:bridge": "tsx test/web_bridge.e2e.ts",
    "fetch:latest": "tsx test/fetch_latest.ts",
    "lint:ext": "npx eslint ../extension",
    "typecheck:ext": "tsc --project ../extension/jsconfig.json",
    "verify:ext": "npm run lint:ext && npm run typecheck:ext",
    "verify:unpacked": "node ../extension/test/verify_unpacked.js",
    "package:all": "powershell -NoProfile -ExecutionPolicy Bypass -File ../extension/scripts/package.ps1 && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-hub.ps1",
    "sync:toolcount": "tsx scripts/sync-tool-count.ts",
    "check:toolcount": "tsx scripts/sync-tool-count.ts --check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "bonjour-service": "^1.4.4",
    "express": "^5.1.0",
    "puppeteer-core": "^25.9.0",
    "qrcode": "^1.5.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
