{
  "manifest_version": 3,
  "name": "ScreenSync MCP",
  "version": "1.14.2",
  "minimum_chrome_version": "114",
  "description": "Supervised AI agent bridge for live browser tabs with Playwright parity, approval gates, and mobile screen sync.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "pages/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "activeTab",
    "debugger",
    "sidePanel",
    "contextMenus",
    "tabGroups",
    "cookies",
    "offscreen",
    "history",
    "bookmarks",
    "webNavigation",
    "downloads",
    "clipboardRead",
    "clipboardWrite",
    "identity",
    "notifications"
  ],
  "side_panel": {
    "default_path": "pages/dashboard.html"
  },
  "commands": {
    "toggle-web-access": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Toggle AI Web Access ON/OFF"
    },
    "open-side-panel": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Open ScreenSync Side Panel"
    }
  },
  "host_permissions": [
    "https://screensyncmcp.epsoldev.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:;"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  }
}
