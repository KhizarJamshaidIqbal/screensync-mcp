<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Allow sharing captured frames from app documents + cache dirs. -->
    <files-path name="captures" path="/" />
    <cache-path name="cache" path="/" />
    <external-files-path name="ext" path="/" />
    <!-- FileSharer.kt shares every file (gallery frames, diagnostics.txt) from
         cacheDir/share/: captures live in app_flutter, which no root covers. -->
    <cache-path name="share" path="share/" />
</paths>
